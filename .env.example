# Paths used by the scripts (copy to .env, edit, then `source .env`).
export DEFECTCON_DATA=/path/to/images        # noVF/{train,test}/{normal,defect}/, VF/train/defect/
export DEFECTCON_SPLITS=/path/to/splits      # split lists written by scripts/build_splits.py
export DEFECTCON_METADATA=/path/to/metadata  # labels and VF source lists (only for build_splits.py)
export DEFECTCON_OUT=/path/to/runs           # training runs, checkpoints and scores
